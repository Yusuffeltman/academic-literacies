{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/xapi/aclit/v1/schemas/help-requested",
  "title": "Help Requested",
  "description": "Validates an xAPI statement generated when a student requests academic help or support.",
  "type": "object",
  "required": ["actor", "verb", "object", "context", "timestamp"],
  "$defs": {
    "account": {
      "type": "object",
      "required": ["homePage", "name"],
      "properties": {
        "homePage": { "type": "string", "format": "uri" },
        "name": { "type": "string" }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "actor": {
      "type": "object",
      "required": ["objectType", "account"],
      "properties": {
        "objectType": { "const": "Agent" },
        "account": { "$ref": "#/$defs/account" }
      }
    },
    "verb": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "const": "http://adlnet.gov/expapi/verbs/asked" },
        "display": { "type": "object" }
      }
    },
    "object": {
      "type": "object",
      "required": ["objectType", "id", "definition"],
      "properties": {
        "objectType": { "const": "Activity" },
        "id": { "type": "string", "format": "uri" },
        "definition": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "https://w3id.org/xapi/aclit/v1/activity-types/help-request" }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["extensions", "contextActivities"],
      "properties": {
        "extensions": {
          "type": "object",
          "required": ["https://w3id.org/xapi/aclit/v1/extensions/help-type"],
          "properties": {
            "https://w3id.org/xapi/aclit/v1/extensions/help-type": {
              "type": "string",
              "enum": ["tutor-question", "support-center", "peer-help", "self-help-resource"]
            }
          }
        },
        "contextActivities": {
          "type": "object",
          "required": ["grouping", "category"],
          "properties": {
            "grouping": {
              "type": "array",
              "minItems": 1,
              "contains": {
                "type": "object",
                "required": ["id", "definition"],
                "properties": {
                  "id": { "type": "string", "format": "uri" },
                  "definition": {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                      "type": { "const": "https://w3id.org/xapi/aclit/v1/activity-types/session" }
                    }
                  }
                }
              }
            },
            "category": {
              "type": "array",
              "minItems": 1,
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "const": "https://w3id.org/xapi/aclit/v1" }
                }
              }
            }
          }
        }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
