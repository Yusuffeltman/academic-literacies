{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/xapi/aclit/v1/schemas/question-answered",
  "title": "Question Answered",
  "description": "Validates an xAPI statement generated when a student answers an individual quiz question.",
  "type": "object",
  "required": ["actor", "verb", "object", "result", "context", "timestamp"],
  "$defs": {
    "account": {
      "type": "object",
      "required": ["homePage", "name"],
      "properties": {
        "homePage": { "type": "string", "format": "uri" },
        "name": { "type": "string" }
      }
    },
    "sessionGrouping": {
      "type": "object",
      "required": ["grouping", "category"],
      "properties": {
        "grouping": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "required": ["id", "definition"],
            "properties": {
              "id": { "type": "string", "format": "uri" },
              "definition": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "const": "https://w3id.org/xapi/aclit/v1/activity-types/session" }
                }
              }
            }
          }
        },
        "category": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "const": "https://w3id.org/xapi/aclit/v1" }
            }
          }
        }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "actor": {
      "type": "object",
      "required": ["objectType", "account"],
      "properties": {
        "objectType": { "const": "Agent" },
        "account": { "$ref": "#/$defs/account" }
      }
    },
    "verb": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "const": "http://adlnet.gov/expapi/verbs/answered" },
        "display": { "type": "object" }
      }
    },
    "object": {
      "type": "object",
      "required": ["objectType", "id", "definition"],
      "properties": {
        "objectType": { "const": "Activity" },
        "id": { "type": "string", "format": "uri" },
        "definition": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "http://adlnet.gov/expapi/activities/cmi.interaction" },
            "interactionType": { "type": "string" },
            "correctResponsesPattern": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["response", "success"],
      "properties": {
        "response": { "type": "string" },
        "success": { "type": "boolean" }
      }
    },
    "context": {
      "type": "object",
      "required": ["contextActivities"],
      "properties": {
        "contextActivities": {
          "type": "object",
          "required": ["parent", "grouping", "category"],
          "properties": {
            "parent": {
              "type": "array",
              "minItems": 1,
              "contains": {
                "type": "object",
                "required": ["id", "definition"],
                "properties": {
                  "id": { "type": "string", "format": "uri" },
                  "definition": {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                      "type": { "const": "http://adlnet.gov/expapi/activities/assessment" }
                    }
                  }
                }
              }
            },
            "grouping": {
              "type": "array",
              "minItems": 1,
              "contains": {
                "type": "object",
                "required": ["id", "definition"],
                "properties": {
                  "id": { "type": "string", "format": "uri" },
                  "definition": {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                      "type": { "const": "https://w3id.org/xapi/aclit/v1/activity-types/session" }
                    }
                  }
                }
              }
            },
            "category": {
              "type": "array",
              "minItems": 1,
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "const": "https://w3id.org/xapi/aclit/v1" }
                }
              }
            }
          }
        }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
