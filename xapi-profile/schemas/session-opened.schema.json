{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/xapi/aclit/v1/schemas/session-opened",
  "title": "Session Opened",
  "description": "Validates an xAPI statement generated when a student logs into the learning platform, starting a new learning session.",
  "type": "object",
  "required": ["actor", "verb", "object", "context", "timestamp"],
  "$defs": {
    "account": {
      "type": "object",
      "required": ["homePage", "name"],
      "properties": {
        "homePage": { "type": "string", "format": "uri" },
        "name": { "type": "string" }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "actor": {
      "type": "object",
      "required": ["objectType", "account"],
      "properties": {
        "objectType": { "const": "Agent" },
        "account": { "$ref": "#/$defs/account" }
      }
    },
    "verb": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "const": "https://brindlewaye.com/xAPITerms/verbs/loggedin" },
        "display": {
          "type": "object",
          "properties": { "en": { "type": "string" } }
        }
      }
    },
    "object": {
      "type": "object",
      "required": ["objectType", "id", "definition"],
      "properties": {
        "objectType": { "const": "Activity" },
        "id": { "type": "string", "format": "uri" },
        "definition": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "https://w3id.org/xapi/aclit/v1/activity-types/session" },
            "name": { "type": "object" },
            "description": { "type": "object" }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["registration", "extensions", "contextActivities"],
      "properties": {
        "registration": { "type": "string", "format": "uuid" },
        "extensions": {
          "type": "object",
          "required": [
            "https://w3id.org/xapi/aclit/v1/extensions/device-type",
            "https://w3id.org/xapi/aclit/v1/extensions/connection-type"
          ],
          "properties": {
            "https://w3id.org/xapi/aclit/v1/extensions/device-type": {
              "type": "string",
              "enum": ["smartphone", "tablet", "desktop", "laptop"]
            },
            "https://w3id.org/xapi/aclit/v1/extensions/connection-type": {
              "type": "string",
              "enum": ["wifi", "mobile-data", "offline", "unknown"]
            }
          }
        },
        "contextActivities": {
          "type": "object",
          "required": ["grouping", "category"],
          "properties": {
            "grouping": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "definition"],
                "properties": {
                  "id": { "type": "string", "format": "uri" },
                  "objectType": { "const": "Activity" },
                  "definition": {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "http://adlnet.gov/expapi/activities/course",
                          "http://adlnet.gov/expapi/activities/module"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "category": {
              "type": "array",
              "minItems": 1,
              "contains": {
                "type": "object",
                "properties": {
                  "id": { "const": "https://w3id.org/xapi/aclit/v1" }
                },
                "required": ["id"]
              }
            }
          }
        }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
