{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/xapi/aclit/v1/schemas/writing-submitted",
  "title": "Writing Submitted",
  "description": "Validates an xAPI statement generated when a student submits a writing task. Either result.response (inline text) or the artifact-url extension should be present for the submission content.",
  "type": "object",
  "required": ["actor", "verb", "object", "result", "context", "timestamp"],
  "$defs": {
    "account": {
      "type": "object",
      "required": ["homePage", "name"],
      "properties": {
        "homePage": { "type": "string", "format": "uri" },
        "name": { "type": "string" }
      }
    },
    "sessionGrouping": {
      "type": "object",
      "required": ["grouping", "category"],
      "properties": {
        "grouping": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "required": ["id", "definition"],
            "properties": {
              "id": { "type": "string", "format": "uri" },
              "definition": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "const": "https://w3id.org/xapi/aclit/v1/activity-types/session" }
                }
              }
            }
          }
        },
        "category": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "const": "https://w3id.org/xapi/aclit/v1" }
            }
          }
        }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "actor": {
      "type": "object",
      "required": ["objectType", "account"],
      "properties": {
        "objectType": { "const": "Agent" },
        "account": { "$ref": "#/$defs/account" }
      }
    },
    "verb": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "const": "http://activitystrea.ms/schema/1.0/submit" },
        "display": { "type": "object" }
      }
    },
    "object": {
      "type": "object",
      "required": ["objectType", "id", "definition"],
      "properties": {
        "objectType": { "const": "Activity" },
        "id": { "type": "string", "format": "uri" },
        "definition": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "https://w3id.org/xapi/aclit/v1/activity-types/writing-task" }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["completion", "extensions"],
      "properties": {
        "completion": { "type": "boolean" },
        "response": { "type": "string" },
        "extensions": {
          "type": "object",
          "required": [
            "https://w3id.org/xapi/aclit/v1/extensions/word-count",
            "https://w3id.org/xapi/aclit/v1/extensions/draft-number",
            "https://w3id.org/xapi/aclit/v1/extensions/assignment-type"
          ],
          "properties": {
            "https://w3id.org/xapi/aclit/v1/extensions/word-count": {
              "type": "integer",
              "minimum": 0
            },
            "https://w3id.org/xapi/aclit/v1/extensions/draft-number": {
              "type": "integer",
              "minimum": 1
            },
            "https://w3id.org/xapi/aclit/v1/extensions/assignment-type": {
              "type": "string",
              "enum": ["paragraph", "essay", "reflection", "report", "summary", "annotated-bibliography"]
            },
            "https://w3id.org/xapi/aclit/v1/extensions/paragraph-count": {
              "type": "integer",
              "minimum": 0
            },
            "https://w3id.org/xapi/aclit/v1/extensions/citation-count": {
              "type": "integer",
              "minimum": 0
            },
            "https://w3id.org/xapi/aclit/v1/extensions/time-spent": {
              "type": "string",
              "pattern": "^P"
            },
            "https://w3id.org/xapi/aclit/v1/extensions/prompt-topic": {
              "type": "string"
            },
            "https://w3id.org/xapi/aclit/v1/extensions/artifact-url": {
              "type": "string",
              "format": "uri"
            },
            "https://w3id.org/xapi/aclit/v1/extensions/artifact-content-type": {
              "type": "string"
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["contextActivities"],
      "properties": {
        "contextActivities": { "$ref": "#/$defs/sessionGrouping" }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
