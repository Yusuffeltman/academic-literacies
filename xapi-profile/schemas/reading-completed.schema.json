{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/xapi/aclit/v1/schemas/reading-completed",
  "title": "Reading Section Completed",
  "description": "Validates an xAPI statement generated when a student completes reading a section of content.",
  "type": "object",
  "required": ["actor", "verb", "object", "result", "context", "timestamp"],
  "$defs": {
    "account": {
      "type": "object",
      "required": ["homePage", "name"],
      "properties": {
        "homePage": { "type": "string", "format": "uri" },
        "name": { "type": "string" }
      }
    },
    "sessionGrouping": {
      "type": "object",
      "required": ["grouping", "category"],
      "properties": {
        "grouping": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "required": ["id", "definition"],
            "properties": {
              "id": { "type": "string", "format": "uri" },
              "definition": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "const": "https://w3id.org/xapi/aclit/v1/activity-types/session" }
                }
              }
            }
          }
        },
        "category": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "const": "https://w3id.org/xapi/aclit/v1" }
            }
          }
        }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "actor": {
      "type": "object",
      "required": ["objectType", "account"],
      "properties": {
        "objectType": { "const": "Agent" },
        "account": { "$ref": "#/$defs/account" }
      }
    },
    "verb": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "const": "http://adlnet.gov/expapi/verbs/completed" },
        "display": { "type": "object" }
      }
    },
    "object": {
      "type": "object",
      "required": ["objectType", "id", "definition"],
      "properties": {
        "objectType": { "const": "Activity" },
        "id": { "type": "string", "format": "uri" },
        "definition": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "https://w3id.org/xapi/aclit/v1/activity-types/reading-section" }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["completion"],
      "properties": {
        "completion": { "const": true }
      }
    },
    "context": {
      "type": "object",
      "required": ["contextActivities"],
      "properties": {
        "contextActivities": { "$ref": "#/$defs/sessionGrouping" }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
