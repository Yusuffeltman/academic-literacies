{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/xapi/aclit/v1/schemas/forum-post-created",
  "title": "Forum Post Created",
  "description": "Validates an xAPI statement generated when a student creates a new top-level forum post in a discussion thread.",
  "type": "object",
  "required": ["actor", "verb", "object", "result", "context", "timestamp"],
  "$defs": {
    "account": {
      "type": "object",
      "required": ["homePage", "name"],
      "properties": {
        "homePage": { "type": "string", "format": "uri" },
        "name": { "type": "string" }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "actor": {
      "type": "object",
      "required": ["objectType", "account"],
      "properties": {
        "objectType": { "const": "Agent" },
        "account": { "$ref": "#/$defs/account" }
      }
    },
    "verb": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "const": "http://activitystrea.ms/schema/1.0/create" },
        "display": { "type": "object" }
      }
    },
    "object": {
      "type": "object",
      "required": ["objectType", "id", "definition"],
      "properties": {
        "objectType": { "const": "Activity" },
        "id": { "type": "string", "format": "uri" },
        "definition": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "http://activitystrea.ms/schema/1.0/note" }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["response", "extensions"],
      "properties": {
        "response": { "type": "string" },
        "extensions": {
          "type": "object",
          "required": ["https://w3id.org/xapi/aclit/v1/extensions/thread-depth"],
          "properties": {
            "https://w3id.org/xapi/aclit/v1/extensions/thread-depth": { "const": 0 },
            "https://w3id.org/xapi/aclit/v1/extensions/word-count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["contextActivities"],
      "properties": {
        "contextActivities": {
          "type": "object",
          "required": ["parent", "grouping", "category"],
          "properties": {
            "parent": {
              "type": "array",
              "minItems": 1,
              "contains": {
                "type": "object",
                "required": ["id", "definition"],
                "properties": {
                  "id": { "type": "string", "format": "uri" },
                  "definition": {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                      "type": { "const": "https://w3id.org/xapi/aclit/v1/activity-types/discussion-thread" }
                    }
                  }
                }
              }
            },
            "grouping": {
              "type": "array",
              "minItems": 1,
              "contains": {
                "type": "object",
                "required": ["id", "definition"],
                "properties": {
                  "id": { "type": "string", "format": "uri" },
                  "definition": {
                    "type": "object",
                    "required": ["type"],
                    "properties": {
                      "type": { "const": "https://w3id.org/xapi/aclit/v1/activity-types/session" }
                    }
                  }
                }
              }
            },
            "category": {
              "type": "array",
              "minItems": 1,
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "const": "https://w3id.org/xapi/aclit/v1" }
                }
              }
            }
          }
        }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
