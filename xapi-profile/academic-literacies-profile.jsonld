    {
      "id": "https://w3id.org/xapi/aclit/v1/templates/quiz-passed",
      "type": "StatementTemplate",
      "inScheme": "https://w3id.org/xapi/aclit/v1",
      "prefLabel": { "en": "Quiz Passed" },
      "definition": { "en": "Generated when a student passes a quiz with a score at or above the passing threshold." },
      "verb": "http://adlnet.gov/expapi/verbs/passed",
      "objectActivityType": "http://adlnet.gov/expapi/activities/assessment",
      "contextGroupingActivityType": ["https://w3id.org/xapi/aclit/v1/activity-types/session"],
      "contextCategoryActivityType": ["https://w3id.org/xapi/aclit/v1"],
      "rules": [
        {
          "location": "$.result.score",
          "presence": "included"
        },
        {
          "location": "$.result.success",
          "presence": "included",
          "all": [true]
        },
        {
