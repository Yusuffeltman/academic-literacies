      "primary": false,
      "inScheme": "https://w3id.org/xapi/aclit/v1",
      "prefLabel": { "en": "Discussion Activity" },
      "definition": { "en": "A discussion forum interaction: view thread, create post, or reply." },
      "alternates": [
        "https://w3id.org/xapi/aclit/v1/templates/thread-viewed",
        "https://w3id.org/xapi/aclit/v1/templates/forum-post-created",
        "https://w3id.org/xapi/aclit/v1/templates/forum-reply-posted"
      ]
    },
    {
      "id": "https://w3id.org/xapi/aclit/v1/patterns/help-seeking-activity",
      "type": "Pattern",
      "primary": false,
      "inScheme": "https://w3id.org/xapi/aclit/v1",
      "prefLabel": { "en": "Help-Seeking Activity" },
      "definition": { "en": "A help-seeking interaction: request help, access a help resource, or request an extension." },
      "alternates": [
        "https://w3id.org/xapi/aclit/v1/templates/help-requested",
        "https://w3id.org/xapi/aclit/v1/templates/help-resource-accessed",
        "https://w3id.org/xapi/aclit/v1/templates/extension-requested"
      ]
    }
