  "patterns": [
    {
      "id": "https://w3id.org/xapi/aclit/v1/patterns/session-lifecycle",
      "type": "Pattern",
      "primary": true,
      "inScheme": "https://w3id.org/xapi/aclit/v1",
      "prefLabel": { "en": "Session Lifecycle" },
      "definition": { "en": "A complete learning session from login to logout, containing zero or more learning activities." },
      "sequence": [
        "https://w3id.org/xapi/aclit/v1/templates/session-opened",
        "https://w3id.org/xapi/aclit/v1/patterns/session-activities",
        "https://w3id.org/xapi/aclit/v1/patterns/session-close-optional"
      ]
    },
    {
      "id": "https://w3id.org/xapi/aclit/v1/patterns/session-activities",
      "type": "Pattern",
      "primary": false,
      "inScheme": "https://w3id.org/xapi/aclit/v1",
      "prefLabel": { "en": "Session Activities (Zero or More)" },
      "definition": { "en": "Zero or more learning activities occurring within a session." },
      "zeroOrMore": "https://w3id.org/xapi/aclit/v1/patterns/session-activity"
    },
    {
      "id": "https://w3id.org/xapi/aclit/v1/patterns/session-close-optional",
      "type": "Pattern",
      "primary": false,
      "inScheme": "https://w3id.org/xapi/aclit/v1",
      "prefLabel": { "en": "Session Close (Optional)" },
      "definition": { "en": "An optional session close event. Sessions may end without explicit logout due to timeout or connectivity loss." },
      "optional": "https://w3id.org/xapi/aclit/v1/templates/session-closed"
    },
    {
      "id": "https://w3id.org/xapi/aclit/v1/patterns/session-activity",
      "type": "Pattern",
      "primary": false,
      "inScheme": "https://w3id.org/xapi/aclit/v1",
      "prefLabel": { "en": "Session Activity" },
      "definition": { "en": "Any learning activity that occurs within a session." },
      "alternates": [
        "https://w3id.org/xapi/aclit/v1/templates/page-viewed",
        "https://w3id.org/xapi/aclit/v1/templates/module-navigated",
        "https://w3id.org/xapi/aclit/v1/patterns/reading-activity",
        "https://w3id.org/xapi/aclit/v1/patterns/quiz-activity",
        "https://w3id.org/xapi/aclit/v1/templates/writing-submitted",
        "https://w3id.org/xapi/aclit/v1/patterns/discussion-activity",
        "https://w3id.org/xapi/aclit/v1/templates/peer-review-submitted",
        "https://w3id.org/xapi/aclit/v1/patterns/help-seeking-activity",
        "https://w3id.org/xapi/aclit/v1/templates/module-completed",
        "https://w3id.org/xapi/aclit/v1/templates/course-progressed",
        "https://w3id.org/xapi/aclit/v1/templates/self-report-submitted"
      ]
    },
    {
      "id": "https://w3id.org/xapi/aclit/v1/patterns/reading-activity",
      "type": "Pattern",
      "primary": false,
      "inScheme": "https://w3id.org/xapi/aclit/v1",
      "prefLabel": { "en": "Reading Activity" },
      "definition": { "en": "A reading interaction: view a section, optionally complete it." },
      "sequence": [
        "https://w3id.org/xapi/aclit/v1/templates/reading-section-viewed",
        "https://w3id.org/xapi/aclit/v1/patterns/reading-completion-optional"
      ]
    },
    {
      "id": "https://w3id.org/xapi/aclit/v1/patterns/reading-completion-optional",
      "type": "Pattern",
      "primary": false,
      "inScheme": "https://w3id.org/xapi/aclit/v1",
      "prefLabel": { "en": "Reading Completion (Optional)" },
      "definition": { "en": "An optional reading section completion event." },
      "optional": "https://w3id.org/xapi/aclit/v1/templates/reading-section-completed"
    },
    {
      "id": "https://w3id.org/xapi/aclit/v1/patterns/quiz-activity",
      "type": "Pattern",
      "primary": false,
      "inScheme": "https://w3id.org/xapi/aclit/v1",
      "prefLabel": { "en": "Quiz Activity" },
      "definition": { "en": "A quiz attempt workflow: attempt, answer questions, then complete with pass/fail outcome." },
      "sequence": [
        "https://w3id.org/xapi/aclit/v1/templates/quiz-attempted",
        "https://w3id.org/xapi/aclit/v1/patterns/quiz-questions",
        "https://w3id.org/xapi/aclit/v1/patterns/quiz-outcome"
      ]
    },
    {
      "id": "https://w3id.org/xapi/aclit/v1/patterns/quiz-questions",
      "type": "Pattern",
      "primary": false,
      "inScheme": "https://w3id.org/xapi/aclit/v1",
      "prefLabel": { "en": "Quiz Questions (One or More)" },
      "definition": { "en": "One or more question-answered events within a quiz attempt." },
      "oneOrMore": "https://w3id.org/xapi/aclit/v1/templates/question-answered"
    },
    {
      "id": "https://w3id.org/xapi/aclit/v1/patterns/quiz-outcome",
      "type": "Pattern",
      "primary": false,
      "inScheme": "https://w3id.org/xapi/aclit/v1",
      "prefLabel": { "en": "Quiz Outcome" },
      "definition": { "en": "The outcome of a quiz attempt: completed, passed, or failed." },
      "alternates": [
        "https://w3id.org/xapi/aclit/v1/templates/quiz-completed",
        "https://w3id.org/xapi/aclit/v1/templates/quiz-passed",
        "https://w3id.org/xapi/aclit/v1/templates/quiz-failed"
      ]
    },
    {
      "id": "https://w3id.org/xapi/aclit/v1/patterns/discussion-activity",
