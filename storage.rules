rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Assessment submission files ──────────────────────────────────────────
    // Students write only to their own uid path.
    // Any authenticated user can read (lecturers/tutors need access to grade).
    match /submissions/{assessmentId}/{studentUid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == studentUid;
      allow read:  if request.auth != null;
    }

    // ── Gallery / collaboration artefacts ────────────────────────────────────
    // Authenticated users write to their own gallery path.
    // All authenticated users can read (group workspace previews).
    match /gallery/assets/{uploaderUid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uploaderUid;
      allow read:  if request.auth != null;
    }

    // ── Deny everything else ─────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
